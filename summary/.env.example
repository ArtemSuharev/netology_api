# === Environment ===
# dev | prod | test
ENV=dev

# === Logging ===
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# === LLM ===
# API-ключ для LLM-провайдера (OpenAI-compatible)
LLM_API_KEY=your-api-key-here

# URL LLM-провайдера (OpenAI-compatible API)
LLM_BASE_URL=https://api.openai.com/v1

# Модель LLM
LLM_MODEL=gpt-4

# === Fallback ===
# Включить fallback-суммаризатор при недоступности LLM
FALLBACK_ENABLED=true

# === Server ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
