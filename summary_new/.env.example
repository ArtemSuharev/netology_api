# LLM configuration
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=default-model
LLM_API_KEY=your-api-key-here
LLM_TIMEOUT=60

# Server configuration
HOST=0.0.0.0
PORT=8000
MAX_TEXT_LENGTH=50000

# Fallback (возвращается при недоступности LLM)
FALLBACK_ENABLED=true
FALLBACK_SUMMARY=Сервис суммаризации временно недоступен. Повторите запрос позже.

# Logging
LOG_LEVEL=info
